#!/usr/bin/env python3
"""The gjson benchmark's grader: grade WORKSPACE ANSWERS.jsonl.

The expected answer to each question is what the real gjson, at upstream
8e88233 (oracle/ref), returns on the question's document and path, computed
now by oracle/cmd/expect from oracle/key.json; nothing is judged. An answer
is normalised before it is compared: surrounding whitespace, one pair of
backticks or quotes around it, and a trailing period are removed; for an
"exists" question yes/true and no/false are accepted. For a string question
whose expected value is itself quoted JSON, the answer must match it exactly.
The workspace is not read: the questions are about gjson at the starting
commit, whose answers the reference shares (NOTES.md).
"""

import json
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent


def norm(s):
    s = str(s).strip()
    if s.endswith(".") and not s[:-1].replace("-", "").isdigit():
        s = s[:-1]
    for q in ("`", '"', "'"):
        if len(s) >= 2 and s[0] == q and s[-1] == q:
            inner = s[1:-1]
            if q == '"':
                try:
                    inner = json.loads(s)
                except json.JSONDecodeError:
                    pass
            return inner if isinstance(inner, str) else s
    return s


def correct(answer, expected, ask):
    if ask == "exists":
        a = norm(answer).lower()
        a = {"yes": "true", "no": "false", "exists": "true", "does not exist": "false"}.get(a, a)
        return a.split()[0].strip(".,") == expected if a else False
    if isinstance(answer, str) and answer == expected:
        return True
    a = answer if not isinstance(answer, str) else norm(answer)
    if not isinstance(a, str):
        a = json.dumps(a, separators=(",", ":"))
    return a == expected or a.strip() == expected.strip() and expected.strip() == expected


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: grade WORKSPACE ANSWERS.jsonl")
    key = json.loads((HERE / "key.json").read_text())
    env = dict(os.environ, GOPROXY="off", GOFLAGS="")
    p = subprocess.run(["go", "run", "./cmd/expect", "key.json"], cwd=HERE,
                       capture_output=True, text=True, env=env, timeout=300)
    if p.returncode != 0:
        print(json.dumps({"error": "reference failed", "stderr": p.stderr[-2000:]}))
        sys.exit(1)
    expected = json.loads(p.stdout)
    answers = {}
    for line in Path(sys.argv[2]).read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            a = json.loads(line)
            answers[str(a.get("id"))] = a.get("answer", "")
        except (json.JSONDecodeError, AttributeError):
            pass
    details = []
    for q in key:
        exp = expected[q["id"]]
        got = answers.get(q["id"])
        ok = got is not None and correct(got, exp, q["ask"])
        details.append({"id": q["id"], "expected": exp, "answer": got, "correct": ok})
    print(json.dumps({"correct": sum(d["correct"] for d in details), "total": len(details),
                      "details": details}))


if __name__ == "__main__":
    main()
