#!/usr/bin/env python3
"""oracle/grade WORKSPACE ANSWERS.jsonl

Grades each answer against GNU coreutils' real output for the question's
command line and input, run with LC_ALL=C in a scratch directory. The
workspace is not read: the right answer is GNU's, whatever the code does.

An answer is correct when, after turning written \\n and \\t into
newlines and tabs, dropping one pair of enclosing quotes or backticks,
trailing white space on each line and trailing empty lines, it equals
GNU's output treated the same way, leading and inner spaces exact. A
"bytes" question is correct when the first number in the answer is the
byte count of GNU's output. "loose" also counts the answers right but
for spacing (runs of white space collapsed), for reference.
"""

import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import questions as qs  # noqa: E402


def gnu(q):
    with tempfile.TemporaryDirectory(prefix="coreutils-grade-") as d:
        for name, data in q["files"].items():
            Path(d, name).write_bytes(data)
        p = subprocess.run(["/usr/bin/" + q["tool"], *q["args"]], input=q["stdin"], cwd=d,
                           env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"}, capture_output=True, timeout=10)
        return p.stdout.decode("latin-1")


def norm(s):
    lines = [l.rstrip() for l in s.split("\n")]
    while lines and lines[-1] == "":
        lines.pop()
    return "\n".join(lines)


def answer_text(a):
    a = a if isinstance(a, str) else json.dumps(a)
    a = a.strip("\n").rstrip()
    if len(a) >= 2 and a[0] == a[-1] and a[0] in "`\"'":
        a = a[1:-1]
    return a.replace("\\n", "\n").replace("\\t", "\t")


def loose(s):
    return "\n".join(" ".join(l.split()) for l in norm(s).split("\n"))


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: grade WORKSPACE ANSWERS.jsonl")
    answers = {}
    for line in Path(sys.argv[2]).read_text().splitlines():
        line = line.strip()
        if line:
            try:
                a = json.loads(line)
                answers[str(a.get("id"))] = a.get("answer", "")
            except (json.JSONDecodeError, AttributeError):
                pass
    out = {"correct": 0, "total": 0, "loose": 0, "details": []}
    for q in qs.questions():
        out["total"] += 1
        want = gnu(q)
        got = answers.get(q["id"])
        ok = lo = False
        if got is not None:
            if q["measure"] == "bytes":
                m = re.search(r"\d+", str(got))
                ok = lo = bool(m) and int(m.group()) == len(want.encode("latin-1"))
                want = str(len(want.encode("latin-1")))
            else:
                a = answer_text(got)
                ok = norm(a) == norm(want)
                lo = loose(a) == loose(want)
        out["correct"] += ok
        out["loose"] += lo
        out["details"].append({"id": q["id"], "correct": ok, "loose": lo, "want": want, "answer": got})
    print(json.dumps(out))


if __name__ == "__main__":
    main()
