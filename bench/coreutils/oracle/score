#!/usr/bin/env python3
"""oracle/score WORKSPACE TASK_NUMBER

Builds the workspace's four tools into a temporary directory (the
workspace itself is never written), runs the generated corpus through GNU
coreutils and through the clone with LC_ALL=C, and compares stdout and the
exit status (and stderr, for the cases about unreadable files). Prints one
JSON object: spec (the seed's base behaviour, every task), tasks (the
features of tasks 1..N), details (the failures, the first few in full).
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import cases as corpus  # noqa: E402

TOOLS = ["cut", "sort", "uniq", "wc"]
GNU = {t: shutil.which(t, path="/usr/bin:/bin") for t in TOOLS}
ENV = {"LC_ALL": "C", "PATH": "/usr/bin:/bin"}
MAX_DETAILS = 40


def build(ws: Path, bindir: Path):
    env = dict(os.environ, GOWORK="off", GOFLAGS="-mod=readonly", CGO_ENABLED="0")
    for t in TOOLS:
        p = subprocess.run(["go", "build", "-o", str(bindir / t), f"./cmd/{t}"], cwd=ws, env=env,
                           capture_output=True, text=True, timeout=300)
        if p.returncode != 0:
            return f"go build ./cmd/{t}: {(p.stdout + p.stderr)[-1500:]}"
    return None


def run(exe, c, cwd):
    try:
        p = subprocess.run([exe, *c["args"]], input=c["stdin"], cwd=cwd, env=ENV,
                           capture_output=True, timeout=10)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return "timeout", b"", b""


def check(c, bindir: Path, scratch: Path):
    d = scratch / c["id"]
    d.mkdir()
    for name, data in c["files"].items():
        (d / name).write_bytes(data)
    want = run(GNU[c["tool"]], c, d)
    got = run(str(bindir / c["tool"]), c, d)
    ok = want[0] == got[0] and want[1] == got[1] and (not c["stderr"] or want[2] == got[2])
    return ok, want, got


def show(b, n=300):
    return b.decode("latin-1")[:n] if isinstance(b, bytes) else b


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: score WORKSPACE TASK_NUMBER")
    ws, upto = Path(sys.argv[1]).resolve(), int(sys.argv[2])
    cases = [c for c in corpus.all_cases() if c["group"] == "spec" or c["group"] <= upto]
    n_spec = sum(c["group"] == "spec" for c in cases)
    out = {"spec": {"passed": 0, "total": n_spec}, "tasks": {"passed": 0, "total": len(cases) - n_spec},
           "by_group": {}, "details": []}
    with tempfile.TemporaryDirectory(prefix="coreutils-oracle-") as tmp:
        tmp = Path(tmp)
        bindir, scratch = tmp / "bin", tmp / "cases"
        bindir.mkdir()
        scratch.mkdir()
        err = build(ws, bindir)
        if err:
            out["details"].append({"error": "build failed", "detail": err})
            print(json.dumps(out))
            return
        failures = []
        for c in cases:
            ok, want, got = check(c, bindir, scratch)
            key = "spec" if c["group"] == "spec" else "tasks"
            g = out["by_group"].setdefault(str(c["group"]), {"passed": 0, "total": 0})
            g["total"] += 1
            if ok:
                out[key]["passed"] += 1
                g["passed"] += 1
            else:
                failures.append((c, want, got))
        for c, want, got in failures[:MAX_DETAILS]:
            out["details"].append({
                "id": c["id"], "group": c["group"], "cmd": " ".join([c["tool"], *c["args"]]),
                "stdin": show(c["stdin"], 200), "files": {k: show(v, 200) for k, v in c["files"].items()},
                "want": {"status": want[0], "stdout": show(want[1]), "stderr": show(want[2], 200)},
                "got": {"status": got[0], "stdout": show(got[1]), "stderr": show(got[2], 200)}})
        if len(failures) > MAX_DETAILS:
            out["details"].append({"more_failures": len(failures) - MAX_DETAILS,
                                   "ids": [c["id"] for c, _, _ in failures[MAX_DETAILS:]]})
    print(json.dumps(out))


if __name__ == "__main__":
    main()
