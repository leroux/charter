#!/usr/bin/env python3
"""The toml benchmark's grader: grade WORKSPACE ANSWERS.jsonl.

Each question (reference.json, written by qgen.py) gives a document and
asks for the value toml-decoder outputs at a key, or whether it accepts
the document. The expected answer is the reference's (TOML 1.0, from
Python's tomllib, frozen), with one exception: when the workspace's
toml-decoder refuses a document the reference accepts (a feature the
workspace has not built), the expected answer is `invalid`, what the code
does. `correct` counts answers matching the expected answer; each detail
also says what the workspace's decoder really output, and `matches_code`
counts answers matching that, drift included.
"""

import json
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import tomltest as T  # noqa: E402


def canon(ref):
    if not ref.get("valid"):
        return "invalid"
    if "type" not in ref:
        return "valid"
    return f"{ref['type']} {ref['value']}"


def code_answer(binary, doc, path):
    code, out, _ = T.run_decoder(binary, doc.encode())
    if code != 0:
        return "invalid"
    if path is None:
        return "valid"
    try:
        v = json.loads(out)
        for p in path:
            v = v[p]
        return f"{v['type']} {v['value']}"
    except Exception:
        return "missing"


def matches(answer, expected):
    a = str(answer).strip().strip("`").strip()
    if expected in ("valid", "invalid"):
        return a.lower().rstrip(".") == expected
    if a.lower().rstrip(".") in ("valid", "invalid", "missing"):
        return False
    m = re.match(r"([A-Za-z-]+)\s*:?\s+(.*)$", a, re.S)
    if not m or " " not in expected:
        return False
    typ, val = m.group(1).lower(), m.group(2).strip()
    et, ev = expected.split(" ", 1)
    candidates = [val]
    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
        candidates.append(val[1:-1])
        if val[0] == '"':
            try:
                candidates.append(json.loads(val))
            except ValueError:
                pass
    return any(T.compare({"type": et, "value": ev}, {"type": typ, "value": c}) is None
               for c in candidates if isinstance(c, str))


def main():
    ws, answers_file = Path(sys.argv[1]).resolve(), Path(sys.argv[2])
    refs = json.loads((T.ORACLE / "reference.json").read_text())
    answers = {}
    for line in answers_file.read_text().splitlines():
        try:
            a = json.loads(line)
            answers[str(a.get("id"))] = a.get("answer", "")
        except (ValueError, AttributeError):
            pass
    binary, err = T.build(ws)
    details, correct, by_code = [], 0, 0
    try:
        for qid, q in refs.items():
            ref = canon(q["reference"])
            code = code_answer(binary, q["doc"], q["path"]) if binary else None
            expected = "invalid" if (code == "invalid" and ref != "invalid") else ref
            ans = answers.get(qid)
            ok = ans is not None and matches(ans, expected)
            okc = ans is not None and code is not None and code != "missing" and matches(ans, code)
            correct += ok
            by_code += okc
            details.append({"id": qid, "feature": q["feature"], "answer": ans, "expected": expected,
                            "reference": ref, "code": code, "correct": ok, "matches_code": okc})
    finally:
        T.cleanup(binary)
    out = {"correct": correct, "total": len(refs), "matches_code": by_code, "details": details}
    if err:
        out["build_error"] = err
    print(json.dumps(out))


if __name__ == "__main__":
    main()
